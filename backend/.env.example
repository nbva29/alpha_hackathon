# Copy to backend/.env for local development.
# Values below are demo-only; never use them in production.
DATABASE_URL=sqlite:///./alfa_demo.db
SECRET_KEY=local-dev-only-change-this-secret-to-a-long-random-value
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
BANK_MOCK_URL=http://127.0.0.1:8001
BANK_INTERNAL_KEY=local-bank-mock-key-change-me
UPLOAD_DIR=./uploads
DEMO_SEED_PASSWORD=demo123
