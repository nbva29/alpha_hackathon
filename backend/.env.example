# Copy to backend/.env for local development.
# Values below are demo-only; never use them in production.
DATABASE_URL=sqlite:///./alfa_demo.db
SECRET_KEY=local-dev-only-change-this-secret-to-a-long-random-value
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
BANK_MOCK_URL=http://127.0.0.1:8001
BANK_INTERNAL_KEY=local-bank-mock-key-change-me
UPLOAD_DIR=./uploads
DEMO_SEED_PASSWORD=demo123
# Start LM Studio's local server and use its exact loaded model ID.
# Set AI_BASE_URL empty to disable inference explicitly; unavailable local model falls back automatically.
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=qwen3-4b-instruct-2507
# Optional bearer token for an expert-supplied OpenAI-compatible endpoint.
AI_API_KEY=
# Remote HTTPS endpoints require an explicit opt-in; keep false for local inference.
AI_ALLOW_REMOTE=false
AI_TIMEOUT_SECONDS=30
